// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: Open Default Keymap`
// from the command palette.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Put key bindings here if you want them to work in normal & visual mode.
      "space f": "editor::Format",
      "space e": "diagnostics::Deploy",
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-shift-b": "workspace::ToggleRightDock",
      "space a": "outline::Toggle",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g c c": "editor::ToggleComments",
      "shift-k": "editor::Hover",
      "ctrl-l": ["tab_switcher::Toggle", { "select_last": true }],
      "ctrl-f": "pane::DeploySearch",
      "g b l": "editor::ToggleGitBlameInline",
      "g h p": "editor::ToggleHunkDiff",
      "g n h": "editor::GoToHunk",
      "g r h": "editor::RevertSelectedHunks",
      "-": "editor::Fold",
      "space": "editor::UnfoldLines",
      "space g": "task::Spawn",
      "ctrl-k": "editor::SelectNext"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // "shift-y": ["workspace::SendKeystrokes", "y $"] // Use neovim's yank behavior: yank to end of line.
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore" // In insert mode, make jk escape to normal mode.
    }
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Put key bindings here (in addition to the context above) if you want them to
      // work when no editor exists.
      // "space f": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "up": "editor::ContextMenuPrev",
      "ctrl-j": "editor::ContextMenuPrev",
      "down": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuNext",
      "pageup": "editor::ContextMenuFirst",
      "pagedown": "editor::ContextMenuLast"
    }
  },
  {
    "context": "Picker || menu",
    "bindings": {
      "ctrl-j": "menu::SelectPrev",
      "ctrl-k": "menu::SelectNext",
      "ctrl-l": "menu::SelectNext"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "shift-p": "file_finder::Toggle"
    }
  }
]
